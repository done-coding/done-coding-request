{
  "name": "@done-coding/request-base",
  "version": "1.2.2-alpha.0",
  "description": "请求基本配置",
  "main": "lib/index.cjs",
  "module": "es/index.mjs",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "import": "./es/index.mjs",
      "require": "./lib/index.cjs",
      "types": "./types/index.d.ts"
    }
  },
  "files": [
    "lib",
    "es",
    "types"
  ],
  "scripts": {
    "serve": "vite",
    "clean": "rimraf es lib types",
    "dev": "vite build --watch",
    "dev:wsl": "nodemon --watch src --exec 'vite build' --ext ts,tsx,js,jsx,css,html --legacy-watch --delay 10",
    "predev": "pnpm run clean",
    "build": "vite build",
    "prebuild": "pnpm run clean",
    "prepack": "pnpm build",
    "test": "echo \"axios、uni等包的单元测试通过即代表本包通过\"",
    "coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "https://gitee.com/done-coding/done-coding-request",
    "directory": "packages/base"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "author": "JustSoSu",
  "license": "MIT",
  "devDependencies": {
    "@types/jsdom": "^21.1.6",
    "@types/lodash.assign": "^4.2.9",
    "@types/lodash.curry": "^4.1.9",
    "@types/lodash.omit": "^4.5.9",
    "@types/qs": "^6.9.9",
    "@vitest/coverage-istanbul": "^1.1.1",
    "csstype": "^3.1.2",
    "jsdom": "^23.0.1",
    "nodemon": "^3.1.9",
    "rimraf": "^5.0.1",
    "typescript": "^5.2.2",
    "vite": "^5.0.10",
    "vite-plugin-dts": "^3.7.0",
    "vitest": "^1.1.1"
  },
  "dependencies": {
    "lodash.assign": "^4.2.0",
    "lodash.curry": "^4.1.1",
    "lodash.omit": "^4.5.0"
  },
  "sideEffects": [],
