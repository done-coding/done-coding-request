{
  "name": "@done-coding/request-uni",
  "version": "1.2.4-alpha.0",
  "description": "请求uni配置",
  "main": "lib/index.cjs",
  "module": "es/index.mjs",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "import": "./es/index.mjs",
      "require": "./lib/index.cjs",
      "types": "./types/index.d.ts"
    }
  },
  "files": [
    "lib",
    "es",
    "types"
  ],
  "scripts": {
    "serve": "echo 'uni 不支持serve'",
    "clean": "rimraf es lib types",
    "dev": "vite build --watch",
    "dev:wsl": "nodemon --watch src --exec 'vite build' --ext ts,tsx,js,jsx,css,html --legacy-watch --delay 10",
    "predev": "pnpm run clean",
    "build": "vite build",
    "prebuild": "pnpm run clean",
    "prepack": "pnpm build",
    "test": "vitest",
    "coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/done-coding/done-coding-request.git",
    "directory": "packages/uni"
  },
  "publishConfig": {
