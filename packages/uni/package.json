    "registry": "https://registry.npmjs.org/"
  },
  "author": "JustSoSu",
  "license": "MIT",
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-app": "2.0.2-3090920231225001",
    "@done-testing/mock-uni-env": "0.0.5",
    "@types/jsdom": "^21.1.6",
    "@types/lodash.get": "^4.4.9",
    "@types/lodash.omit": "^4.5.9",
    "@types/qs": "^6.9.9",
    "@vitest/coverage-istanbul": "^1.1.1",
    "csstype": "^3.1.2",
    "jsdom": "^23.0.1",
    "msw": "^2.2.8",
    "nodemon": "^3.1.9",
    "rimraf": "^5.0.1",
    "typescript": "^5.2.2",
    "vite": "^5.0.10",
    "vite-plugin-dts": "^3.7.0",
    "vitest": "^1.1.1"
  },
  "sideEffects": [],
