{
  "name": "@done-coding/request-ofetch",
  "version": "1.1.0",
  "description": "请求ofetch配置 支持nuxt",
  "main": "lib/index.cjs",
  "module": "es/index.mjs",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "import": "./es/index.mjs",
      "require": "./lib/index.cjs",
      "types": "./types/index.d.ts"
    }
  },
  "files": [
    "lib",
    "es",
    "types"
  ],
  "scripts": {
    "serve": "vite",
    "clean": "rimraf es lib types",
    "dev": "vite build --watch",
    "dev:wsl": "nodemon --watch src --exec 'vite build' --ext ts,tsx,js,jsx,css,html --legacy-watch --delay 10",
    "predev": "pnpm run clean",
    "build": "vite build",
    "prebuild": "pnpm run clean",
    "prepack": "pnpm build",
    "test": "vitest",
    "coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git@gitee.com:justsosu/done-coding-request.git",
    "directory": "packages/ofetch"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "author": "JustSoSu",
  "license": "MIT",
  "devDependencies": {
    "@types/jsdom": "^21.1.6",
    "@types/lodash.get": "^4.4.9",
    "@types/lodash.omit": "^4.5.9",
    "@types/qs": "^6.9.9",
    "@vitest/coverage-istanbul": "^1.1.1",
    "csstype": "^3.1.2",
    "jsdom": "^23.0.1",
    "msw": "^2.2.8",
    "nodemon": "^3.1.9",
    "ofetch": "^1.3.4",
    "rimraf": "^5.0.1",
    "typescript": "^5.2.2",
    "vite": "^5.0.10",
    "vite-plugin-dts": "^3.7.0",
    "vitest": "^1.1.1"
  },
  "sideEffects": [],
  "dependencies": {
    "@done-coding/request-base": "workspace:^",
    "lodash.get": "^4.4.2",
    "lodash.omit": "^4.5.0"
  },
  "peerDependencies": {
    "ofetch": "^1.3.4"
  }
}
